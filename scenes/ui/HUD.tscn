[gd_scene load_steps=2 format=3 uid="uid://hud"]

[ext_resource type="Script" path="res://scripts/ui/HUD.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="MarginContainer" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_bottom = 6

[node name="VBoxContainer" type="VBoxContainer" parent="MarginContainer"]
size_flags_vertical = 3

[node name="TopBar" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
theme_override_constants/separation = 12

[node name="ScoreLabel" type="Label" parent="MarginContainer/VBoxContainer/TopBar"]
text = "SCORE: 0000000"
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 0.9, 0.2, 1)

[node name="WaveLabel" type="Label" parent="MarginContainer/VBoxContainer/TopBar"]
text = "WAVE 1"
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.4, 0.9, 1, 1)

[node name="LivesContainer" type="HBoxContainer" parent="MarginContainer/VBoxContainer/TopBar"]
theme_override_constants/separation = 2

[node name="PauseButton" type="Button" parent="MarginContainer/VBoxContainer/TopBar"]
text = "II"
custom_minimum_size = Vector2(36, 30)
theme_override_font_sizes/font_size = 14

[node name="PowerUpBar" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
theme_override_constants/separation = 10

[node name="TripleShotIcon" type="HBoxContainer" parent="MarginContainer/VBoxContainer/PowerUpBar"]
modulate = Color(1, 1, 1, 0.3)

[node name="Label" type="Label" parent="MarginContainer/VBoxContainer/PowerUpBar/TripleShotIcon"]
text = "3X"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(1, 0.85, 0, 1)

[node name="ShieldIcon" type="HBoxContainer" parent="MarginContainer/VBoxContainer/PowerUpBar"]
modulate = Color(1, 1, 1, 0.3)

[node name="Label" type="Label" parent="MarginContainer/VBoxContainer/PowerUpBar/ShieldIcon"]
text = "SH"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.3, 0.6, 1, 1)

[node name="SpeedIcon" type="HBoxContainer" parent="MarginContainer/VBoxContainer/PowerUpBar"]
modulate = Color(1, 1, 1, 0.3)

[node name="Label" type="Label" parent="MarginContainer/VBoxContainer/PowerUpBar/SpeedIcon"]
text = "SP"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.2, 1, 0.4, 1)

[node name="Spacer" type="Control" parent="MarginContainer/VBoxContainer"]
size_flags_vertical = 3

[node name="TouchControls" type="HBoxContainer" parent="MarginContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 120)
theme_override_constants/separation = 20
visible = true

[node name="LeftButton" type="Button" parent="MarginContainer/VBoxContainer/TouchControls"]
text = "<"
size_flags_horizontal = 3
custom_minimum_size = Vector2(120, 110)
theme_override_font_sizes/font_size = 40

[node name="RightButton" type="Button" parent="MarginContainer/VBoxContainer/TouchControls"]
text = ">"
size_flags_horizontal = 3
custom_minimum_size = Vector2(120, 110)
theme_override_font_sizes/font_size = 40

[node name="ShootButton" type="Button" parent="MarginContainer/VBoxContainer/TouchControls"]
text = "FIRE"
size_flags_horizontal = 3
custom_minimum_size = Vector2(120, 110)
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)
